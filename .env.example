# Environment Variables for Knight AI

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knight_ai"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="knight-ai-dev-secret-key-replace-in-production-at-least-32-chars"

# Google Gemini API
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# AI Demo Mode (When "true" or when GEMINI_API_KEY is unset, uses deterministic structured demo generation)
AI_DEMO_MODE="false"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
